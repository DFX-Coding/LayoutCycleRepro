<Window
    x:Class="LayoutCycleRepro.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LayoutCycleRepro"
    Title="WinUI layout cycle reproduction">
    <Grid x:Name="Root" Margin="16" HorizontalAlignment="Left" VerticalAlignment="Top" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Click="OnPrepare" Content="Jump Down" />
            <Button Click="OnScrollToTop" Content="Scroll to Top" />
            <Button Click="OnDump" Content="Print Debug Log" />
        </StackPanel>
        <TextBlock x:Name="Instructions" Grid.Row="1" MaxWidth="1183" TextWrapping="Wrap" />
        <ScrollView
            x:Name="CaseScrollView"
            Grid.Row="2"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto"
            IsTabStop="True">
            <!-- Content geometry: 64 DIP before the list, 48 after it, 24 per side. -->
            <Border x:Name="PageContentContainer">
                <Grid x:Name="PagePadding">
                    <ContentPresenter>
                        <Grid x:Name="PageContent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border x:Name="LeadingRow" />
                            <Border Grid.Row="1" Visibility="Collapsed" />
                            <ItemsRepeater x:Name="CaseRepeater" Grid.Row="2">
                                <ItemsRepeater.Layout>
                                    <StackLayout x:Name="CaseLayout" Orientation="Vertical" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="local:ReproItem">
                                        <Border
                                            Height="{x:Bind Height}"
                                            MinWidth="{x:Bind DesiredWidth}"
                                            Padding="12"
                                            HorizontalAlignment="Stretch"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                            <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Grid>
                    </ContentPresenter>
                </Grid>
            </Border>
        </ScrollView>
    </Grid>
</Window>
